# ===============================================================
# Copiaza acest fisier in ".env" si completeaza valorile.
# .env NU se pune niciodata in Git (vezi .gitignore).
# Regula din curs (slide 28): cheile stau in environment, nu in cod.
# ===============================================================

# --- Modelele AI -------------------------------------------------
# Scrii fiecare model ca  provider/nume_model , separate prin virgula.
# Provideri acceptati: gemini, ollama.
#
#   MODELE_ACTIVE   - agentul le poate folosi. PRIMUL e cel cu care porneste.
#   MODELE_INACTIVE - definite, dar oprite. Raman vizibile in /modele.
#
# Ca sa pornesti sau sa opresti un model, il muti dintr-o linie in alta.
# Comanda /modele din CLI arata lista, iar /model <nr> comuta intre cele active.
MODELE_ACTIVE=gemini/gemini-3.6-flash, gemini/gemini-3.8-flash
MODELE_INACTIVE=gemini/gemini-3.5-flash-lite, gemini/gemini-3.1-flash-lite, gemini/gemini-2.5-flash-lite, ollama/qwen2.5:3b

# --- Ollama (local, gratuit, nu cere cheie) ----------------------
# Ruleaza: docker-compose up -d   (din share_lectia1)
OLLAMA_BASE_URL=http://localhost:11434

# --- Google Gemini ----------------------------------------------
# Cheie gratuita de pe: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Parametri de generare --------------------------------------
# temperature 0 = raspunsuri stabile, reproductibile. Pentru un agent
# care da preturi si disponibilitate vrem exact asta, nu creativitate.
TEMPERATURE=0
MAX_TOKENS=2048

# --- ReAct loop (Lectia 2, S6.7) --------------------------------
# Plasa de siguranta: fara ea, un agent poate intra in bucla infinita.
MAX_ITERATIONS=8

# Celelalte trei plase de siguranta din S6.7:
#   plafon de tokeni pe toata tura (MAX_TOKENS de sus limiteaza un raspuns)
MAX_TOKENS_TURA=50000
#   cat are voie sa dureze un tool, in secunde
TOOL_TIMEOUT=10
#   circuit breaker: dupa atatea erori intr-o tura, tool-ul nu mai e apelat
TOOL_MAX_ERORI=3

# --- Identitatea agentului --------------------------------------
# Valorile astea se injecteaza in system prompt prin Jinja2, la runtime.
# Le schimbi aici, nu in fisierul .yaml - promptul ramane acelasi sablon.
NUME_COMPANIE=CamperHub
NUME_AGENT=Ruta
CANAL_CONTACT=echipa de rezervari

# --- LangSmith / Observability (Lectia 2, S8.3) -----------------
# Cont gratuit pe: https://smith.langchain.com  -> Settings -> API Keys
# true = fiecare intrebare a clientului devine un "trace" vizibil in LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
# Proiecte separate pe mediu (S8.8): -dev acum, -prod cand ajunge la clienti.
LANGCHAIN_PROJECT=qa-agent-autorulote-dev
# Regiunea contului. Lasa asa daca contul e pe smith.langchain.com (SUA).
# Daca l-ai creat pe eu.smith.langchain.com (UE), foloseste:
#   LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
